.DS_Store
Thumbs.db

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local/editor state
.idea/
.vscode/

# Generated workflow outputs. The submitted volume inputs needed by the
# oceanic biomass scripts can be added explicitly with git add -f.
runs/*
!runs/geothermal/
!runs/geothermal/1stAttempt/
!runs/geothermal/1stAttempt/total_continental.csv
!runs/geothermal/1stAttempt/total_oceanic.csv
!runs/geothermal/1stAttempt/oceanic_final/
!runs/geothermal/1stAttempt/oceanic_final/myModel1st.model
!runs/geothermal/1stAttempt/continental_final/
!runs/geothermal/1stAttempt/continental_final/myModel1st.model

# Curated reference output used for the revision's oceanic Table S4.
!runs/oceanic/
runs/oceanic/*
!runs/oceanic/submitted/
!runs/oceanic/submitted/2026-07-16_final_table_s4_1000_draws/
!runs/oceanic/submitted/2026-07-16_final_table_s4_1000_draws/**
!runs/oceanic/submitted/2026-07-16_z122_uncertainty_draw_totals/
!runs/oceanic/submitted/2026-07-16_z122_uncertainty_draw_totals/**

# Compact reference tables for the two continental biomass workflows.
!runs/continental/
runs/continental/*
!runs/continental/submitted/
runs/continental/submitted/*
!runs/continental/submitted/2026-07-18_reference_summaries/
!runs/continental/submitted/2026-07-18_reference_summaries/**

# Smoke-test artefacts are regenerated by tests and are never release outputs.
runs/geothermal/testAttempt/

# Local aggregation input directory. Its curated Table S4 summaries are copied
# to runs/oceanic/submitted/ instead of being versioned in full.
oceanic_biomass_results_temp/

# Keep generated figures out of source control unless explicitly added.
figures/generated/

# Logs and temporary files
*.log
*.tmp
